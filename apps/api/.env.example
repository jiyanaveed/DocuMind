# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# AI Provider (swap to change providers)
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your-ai-api-key
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

# Database (Supabase → Settings → Database → Connection string → URI → Transaction mode)
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-region.pooler.supabase.com:6543/postgres

# API
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# CORS
FRONTEND_URL=https://your-app.vercel.app
